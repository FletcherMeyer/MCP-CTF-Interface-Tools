{
  "manifest_version": 3,
  "name": "harscope capture",
  "version": "0.1.0",
  "description": "Capture the current tab's HTTP traffic as a HAR and send it to a harscope Claude Code session. Localhost only; no data leaves your machine.",
  "permissions": ["debugger", "storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "harscope capture" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
